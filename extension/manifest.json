{
  "manifest_version": 3,
  "name": "Yandex Browser MCP Bridge",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Мост между локальным MCP-сервером и уже открытыми вкладками Яндекс Браузера.",
  "permissions": ["debugger", "tabs", "alarms", "downloads"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Yandex Browser MCP",
    "default_popup": "popup.html"
  }
}
